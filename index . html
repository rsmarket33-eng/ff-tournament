<!DOCTYPE html>
<html><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>FF TOURNAMENT</title>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/9.22.0/firebase-database-compat.js"></script>
<script>const firebaseConfig={apiKey:"AIzaSyBZfdiO3UerR8REGA9c89tUNiiHb7XYTvg",authDomain:"ff-tournament-195a0.firebaseapp.com",databaseURL:"https://ff-tournament-195a0-default-rtdb.asia-southeast1.firebasedatabase.app",projectId:"ff-tournament-195a0",storageBucket:"ff-tournament-195a0.firebasestorage.app",appId:"1:925685630059:android:48a9b36caaa22b48a0dd2e"};firebase.initializeApp(firebaseConfig);const db=firebase.database();</script>
<style>body{margin:0;font-family:sans-serif;background:#0f0f0f;color:white}.topbar{background:#000;padding:12px 15px;display:flex;justify-content:space-between;border-bottom:2px solid #FFEB3B;align-items:center}.card{background:#1e1e1e;margin:10px 12px;padding:14px;border-radius:12px;border:1px solid #333}.btnYellow{background:#FFEB3B;color:black;width:100%;padding:13px;border:none;border-radius:10px;font-weight:bold;margin-top:10px;cursor:pointer}.btnGreen{background:#00C853;color:white;padding:6px 14px;border:none;border-radius:20px;font-size:12px;font-weight:bold;cursor:pointer}.input{width:100%;padding:12px;border-radius:8px;border:1px solid #444;background:#2a2a2a;color:white;box-sizing:border-box;margin-top:8px}.loginScreen{position:fixed;top:0;left:0;width:100%;height:100%;background:#0f0f0f;display:flex;justify-content:center;align-items:center;z-index:9999;padding:20px;box-sizing:border-box}.loginBox{background:#1e1e1e;width:100%;max-width:360px;padding:25px;border-radius:20px;border:1px solid #333}.tourCard{background:white;color:black;padding:12px;border-radius:12px;margin-top:10px}.walletGrid{display:flex;gap:10px;flex-wrap:wrap}.walletLeft{flex:1;min-width:280px;background:#1a1a2e;padding:14px;border-radius:12px;border:1px solid #7b2cff}.walletRight{flex:1;min-width:280px;background:#1a1a2e;padding:14px;border-radius:12px;border:1px solid #FFEB3B}</style>
</head><body>
<div class="loginScreen" id="loginScreen"><div class="loginBox"><h2 style="color:#FFEB3B;text-align:center;margin:0">FF TOURNAMENT</h2><input id="inpName" class="input" placeholder="Apna Username"><input id="inpFFID" class="input" placeholder="Free Fire UID"><input id="inpPass" class="input" type="password" placeholder="Password"><button class="btnYellow" onclick="doLogin()">Login / Register</button><small id="loginMsg" style="color:lightgreen;display:block;text-align:center;margin-top:10px"></small></div></div>
<div class="topbar"><div style="color:#FFEB3B;font-weight:bold">FF TOURNAMENT</div><div style="display:flex;gap:6px;align-items:center"><button class="btnGreen" onclick="openSupport()">HELP</button><div id="bal" style="background:#FFEB3B;color:black;padding:5px 10px;border-radius:15px;font-size:12px;font-weight:bold">Rs. 0</div></div></div>
<div class="card walletGrid"><div class="walletLeft"><b style="color:#7b2cff">CUSTOMER INFO</b><br><div style="margin-top:10px"><small style="color:#aaa">Name</small><br><b id="showName">Player</b></div><div style="margin-top:8px"><small style="color:#aaa">FF ID</small><br><b id="showFFID">-</b></div></div><div class="walletRight"><b style="color:#FFEB3B">PAYMENT & ACCOUNT</b><br><small style="color:#aaa">JazzCash / Easypaisa / Bank</small><br><div style="background:#2a2a2a;padding:8px;border-radius:8px;margin-top:8px;font-size:12px">JazzCash: 03291388253 - Abdul Rahman</div><button class="btnYellow" onclick="openCash()">+ ADD FUND</button><button onclick="doLogout()" style="background:#333;color:white;width:100%;padding:8px;border:none;border-radius:8px;margin-top:8px;font-size:12px">Logout</button></div></div>
<div id="tourList"></div>
<div id="cashPop" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);justify-content:center;align-items:center;z-index:99;padding:20px;box-sizing:border-box"><div style="background:#1e1e1e;padding:20px;border-radius:15px;width:100%;max-width:380px;max-height:90vh;overflow-y:auto"><h3 style="color:#FFEB3B;margin-top:0">ADD FUND</h3><input id="amt" class="input" type="number" placeholder="Amount"><input id="payFile" class="input" type="file" accept="image/*"><img id="payPreview" style="width:100%;margin-top:10px;border-radius:10px;display:none"><div id="trxBox" style="display:none"><input id="tid" class="input" placeholder="Transaction ID (agar screenshot me na ho)"></div><div id="autoCheckStatus" style="margin-top:10px;padding:8px;border-radius:8px;font-size:12px;display:none"></div><button class="btnYellow" onclick="submitCash()">Submit For Verification</button><button onclick="closeCash()" style="background:#333;color:white;width:100%;padding:10px;border:none;border-radius:8px;margin-top:8px">Cancel</button><p id="payStatus" style="font-size:12px;color:lightgreen"></p></div></div>
<div id="winPop" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.9);justify-content:center;align-items:center;z-index:100;padding:20px;box-sizing:border-box"><div style="background:#1e1e1e;padding:20px;border-radius:15px;width:100%;max-width:360px"><h3 style="color:#FFEB3B;margin-top:0">WIN CLAIM</h3><input id="winUID" class="input" placeholder="Free Fire UID"><input id="winWallet" class="input" placeholder="JazzCash Number"><input id="winFile" class="input" type="file" accept="image/*"><img id="winPreview" style="width:100%;margin-top:10px;border-radius:10px;display:none"><button class="btnYellow" onclick="submitWinClaim()">Submit Claim</button><button onclick="closeWinClaim()" style="background:#333;color:white;width:100%;padding:10px;border:none;border-radius:8px;margin-top:8px">Cancel</button><p id="winStatus" style="font-size:12px;color:lightgreen"></p></div></div>
<div id="supportPop" style="display:none;position:fixed;top:0;left:0;width:100%;height:100%;background:rgba(0,0,0,0.95);justify-content:center;align-items:center;z-index:101;padding:20px;box-sizing:border-box"><div style="background:#1e1e1e;padding:20px;border-radius:15px;width:100%;max-width:380px;max-height:85vh;display:flex;flex-direction:column"><h3 style="color:#00C853;margin-top:0">Support</h3><div id="supportList" style="flex:1;overflow-y:auto;background:#111;padding:10px;border-radius:10px;margin-bottom:10px;max-height:300px"></div><textarea id="supportMsg" class="input" placeholder="Apna masla likhein" rows="3"></textarea><button class="btnYellow" style="background:#00C853;color:white" onclick="sendSupportMsg()">Send</button><button onclick="closeSupport()" style="background:#333;color:white;width:100%;padding:10px;border:none;border-radius:8px;margin-top:8px">Close</button><p id="supportStatus" style="font-size:12px;color:lightgreen"></p></div></div>
<script>
let currentUser=JSON.parse(localStorage.getItem('ff_current_user')||'null');
let tourLimits={t1:2,t2:4,t3:8,t4:10,t5:20,t6:48};
let defaultTours={t1:{title:"1 VS 1 - CUSTOM",prize:"Winner Rs. 100",fee:20},t2:{title:"2 VS 2 - CUSTOM",prize:"Winner Rs. 200",fee:40},t3:{title:"4 VS 4 - CUSTOM",prize:"Winner Rs. 400",fee:60},t4:{title:"10 Players",prize:"Winner Rs. 500",fee:50},t5:{title:"20 Players",prize:"Winner Rs. 1000",fee:80},t6:{title:"48 Players",prize:"Winner Rs. 2500",fee:100}};
let currentClaimTour=""; let currentClaimImageBase64=""; let currentPayImageBase64="";
if(currentUser){document.getElementById('loginScreen').style.display='none';initApp();}
function doLogin(){let name=document.getElementById('inpName').value.trim();let ffid=document.getElementById('inpFFID').value.trim();let pass=document.getElementById('inpPass').value.trim();if(!name||!ffid||!pass){alert("Teeno likho");return;}db.ref('ff_users/'+name).once('value',snap=>{let u=snap.val();if(u){if(u.password&&u.password!==pass){alert("Galat Password");return;}currentUser={username:name,ffid:ffid||u.ffid,balance:u.balance||0,password:pass};localStorage.setItem('ff_current_user',JSON.stringify(currentUser));db.ref('ff_users/'+name).update({username:name,ffid:ffid||u.ffid,password:pass});document.getElementById('loginScreen').style.display='none';initApp();}else{currentUser={username:name,ffid:ffid,balance:0,password:pass};localStorage.setItem('ff_current_user',JSON.stringify(currentUser));db.ref('ff_users/'+name).set(currentUser).then(()=>{document.getElementById('loginScreen').style.display='none';initApp();});}});}
function doLogout(){if(confirm("Logout?")){localStorage.removeItem('ff_current_user');location.reload();}}
function initApp(){document.getElementById('showName').innerText=currentUser.username;document.getElementById('showFFID').innerText=currentUser.ffid;db.ref('ff_users/'+currentUser.username+'/balance').on('value',snap=>{let bal=snap.val()||0;document.getElementById('bal').innerText="Rs. "+bal;currentUser.balance=bal;});document.getElementById('winFile').addEventListener('change',function(e){let file=e.target.files[0];if(!file)return;let r=new FileReader();r.onload=function(ev){currentClaimImageBase64=ev.target.result;document.getElementById('winPreview').src=currentClaimImageBase64;document.getElementById('winPreview').style.display='block';};r.readAsDataURL(file);});document.getElementById('payFile').addEventListener('change',function(e){let file=e.target.files[0];if(!file)return;let r=new FileReader();r.onload=function(ev){currentPayImageBase64=ev.target.result;document.getElementById('payPreview').src=currentPayImageBase64;document.getElementById('payPreview').style.display='block';runAutoChecker(file);};r.readAsDataURL(file);});loadTours();loadSupportMsgs();}
function showAutoCheck(s,m){let b=document.getElementById('autoCheckStatus');b.style.display='block';if(s==="REAL"){b.style.background="#00C85322";b.style.border="1px solid #00C853";b.style.color="#00C853";}else if(s==="NEED_TRX"){b.style.background="#FFEB3B22";b.style.border="1px solid #FFEB3B";b.style.color="#FFEB3B";}else{b.style.background="#ff000022";b.style.border="1px solid red";b.style.color="red";}b.innerText=m;}
function runAutoChecker(file){if(file.name.toLowerCase().includes("fake")){showAutoCheck("REJECTED","❌ FAKE Screenshot!");currentPayImageBase64="";document.getElementById('payPreview').style.display='none';return;}showAutoCheck("NEED_TRX","✅ Real Lag Raha Hai - Agar TrxID screenshot me nahi to neeche likh dein");document.getElementById('trxBox').style.display='block';}
function loadTours(){db.ref('joined').on('value',allJoinedSnap=>{let allJoined=allJoinedSnap.val()||{};let counts={t1:0,t2:0,t3:0,t4:0,t5:0,t6:0};let myJoined={};for(let k in allJoined){let j=allJoined[k];if(counts[j.tour]!==undefined)counts[j.tour]++;if(j.username===currentUser.username)myJoined[j.tour]=j;}db.ref('tournament_rooms').on('value',snap=>{let data=snap.val()||defaultTours;let html="";for(let key in defaultTours){let t=data[key]||defaultTours[key];let limit=tourLimits[key];let joinedCount=counts[key]||0;let isJoined=!!myJoined[key];let isFull=joinedCount>=limit;let dateTimeBadge=`<div style="margin-top:8px;background:#000;color:#FFEB3B;padding:6px 10px;border-radius:8px;display:inline-block;font-size:12px">Date: ${t.tournamentDate||'Not Set'} | Time: ${t.tournamentTime||'Not Set'}</div>`;let roomSection="";if(isJoined){roomSection=`<div style="background:#e8f5e9;padding:10px;border-radius:8px;margin-top:10px;border:1px solid green"><b style="color:green">You Joined!</b><br>Room: <b>${t.roomCode||'Admin dega'}</b> Pass: <b>${t.roomPass||''}</b></div>`;}let btn=isJoined?`<button class="btnYellow" style="background:#ccc">JOINED</button><button onclick="openWinClaim('${key}')" style="background:#000;color:#FFEB3B;border:2px solid #FFEB3B;width:100%;padding:10px;border-radius:10px;margin-top:8px">WIN CLAIM</button>`:isFull?`<button class="btnYellow" style="background:red">FULL</button>`:`<button class="btnYellow" onclick="joinTour('${key}',${t.fee})">JOIN - Rs.${t.fee}</button>`;html+=`<div class="card"><div class="tourCard"><b>${t.title}</b><br><small style="color:green;font-weight:bold">${t.prize}</small><br>${dateTimeBadge}<div style="margin-top:8px;background:#000;color:#FFEB3B;padding:6px 10px;border-radius:20px;display:inline-block;font-size:12px">${joinedCount}/${limit} Joined</div>${roomSection}${btn}</div></div>`;}document.getElementById('tourList').innerHTML=html;});});}
function joinTour(k,f){if(currentUser.balance<f){alert("Balance Kam!");return;}db.ref('joined').once('value',snap=>{let all=snap.val()||{};let c=0;for(let x in all){if(all[x].tour===k)c++;}if(c>=tourLimits[k]){alert("Full");return;}if(!confirm("Rs."+f+" Join?"))return;let nb=currentUser.balance-f;db.ref('ff_users/'+currentUser.username+'/balance').set(nb);db.ref('joined/'+currentUser.username+'_'+k).set({username:currentUser.username,ffid:currentUser.ffid,tour:k,time:Date.now()});});}
function openCash(){document.getElementById('cashPop').style.display='flex';}function closeCash(){document.getElementById('cashPop').style.display='none';document.getElementById('payPreview').style.display='none';document.getElementById('trxBox').style.display='none';document.getElementById('autoCheckStatus').style.display='none';}
function submitCash(){let amt=document.getElementById('amt').value;let tid=document.getElementById('tid').value.trim();if(!amt){alert("Amount");return;}if(!currentPayImageBase64){alert("Screenshot");return;}document.getElementById('payStatus').innerText="Sending...";let newKey=db.ref('payment_requests').push().key;db.ref('payment_requests/'+newKey).set({username:currentUser.username,ffid:currentUser.ffid,amount:amt,trxId:tid||"IN_SCREENSHOT",screenshot:currentPayImageBase64,status:'pending',time:Date.now()}).then(()=>{document.getElementById('payStatus').innerText="✅ Sent To Admin!";setTimeout(closeCash,1500);});}
function openWinClaim(t){currentClaimTour=t;document.getElementById('winPop').style.display='flex';}function closeWinClaim(){document.getElementById('winPop').style.display='none';}
function submitWinClaim(){let uid=document.getElementById('winUID').value;let wal=document.getElementById('winWallet').value;if(!uid||!wal||!currentClaimImageBase64){alert("Sab likho");return;}let newKey=db.ref('win_claims').push().key;db.ref('win_claims/'+newKey).set({username:currentUser.username,ffid:currentUser.ffid,tour:currentClaimTour,uid:uid,wallet:wal,screenshot:currentClaimImageBase64,status:'pending',time:Date.now()}).then(()=>{document.getElementById('winStatus').innerText="✅ Sent!";setTimeout(closeWinClaim,1500);});}
function openSupport(){document.getElementById('supportPop').style.display='flex';}function closeSupport(){document.getElementById('supportPop').style.display='none';}
function sendSupportMsg(){let m=document.getElementById('supportMsg').value.trim();if(!m)return;let newKey=db.ref('support_msgs').push().key;db.ref('support_msgs/'+newKey).set({username:currentUser.username,msg:m,reply:"",time:Date.now()}).then(()=>{document.getElementById('supportStatus').innerText="Sent!";document.getElementById('supportMsg').value="";});}
function loadSupportMsgs(){db.ref('support_msgs').on('value',snap=>{let data=snap.val()||{};let html="";for(let k in data){let x=data[k];if(x.username===currentUser.username){html+=`<div style="background:#1e1e1e;padding:8px;border-radius:8px;margin-top:6px"><b style="font-size:12px">${x.username}</b><br><small>${x.msg}</small>${x.reply?`<br><small style="color:lightgreen">Admin: ${x.reply}</small>`:''}</div>`;}}document.getElementById('supportList').innerHTML=html||"<small>No msgs</small>";});}
</script>
</body></html>
